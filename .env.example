PIUROFORGE_CONFIG_DIR=
# Supported llm_backend values: codex_cli, gemini_cli, claude_code
PIUROFORGE_LLM_BACKEND=codex_cli
PIUROFORGE_CODEX_CMD=codex
PIUROFORGE_CODEX_TIMEOUT_SECS=120
PIUROFORGE_GEMINI_CMD=gemini
PIUROFORGE_GEMINI_TIMEOUT_SECS=120
PIUROFORGE_CLAUDE_CODE_CMD=claude
PIUROFORGE_CLAUDE_CODE_TIMEOUT_SECS=120
PIUROFORGE_ALLOW_DUMMY=false
PIUROFORGE_LOG_PROMPTS=false
PIUROFORGE_WORKSPACE_AUTO_COMMIT=false

# install.sh only
PIUROFORGE_INSTALL_DIR=
PIUROFORGE_VERSION=latest
PIUROFORGE_REPO=piuro-works/piuroforge
PIUROFORGE_DOWNLOAD_URL=
